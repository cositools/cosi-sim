# Same range cuts as the DC3/DC4 sources (optimizes sim time):
DefaultRangeCut 0.005
Region Spacecraft
Spacecraft.Volume SCbody
Spacecraft.RangeCut 1.

Region Pipebody
Pipebody.Volume PIPbody
Pipebody.RangeCut 1.

DetectorTimeConstant 0.000002

# Particle event R2_DISTPAR0022, 300 s, in 3 pieces (one component each) built at the attitude of their
# time span (yaw change <= 10 deg per piece); together they make up the event.

# Piece 1 of 3: 0-98.511 s after the event start.
# Distant particle event: bremsstrahlung from electrons (exp(-E/500 keV)) precipitating
# over 90000 km2 at 10 deg Earth-central angle (1272 km away, zenith 119.5 deg,
# azimuth 180 deg from north). Peak precipitating flux 9.2e+03 e/cm2/s above 50 keV.
# Peak photon flux at COSI 0.255 ph/cm2/s; Flux below is the lightcurve-averaged value.
# Rocking +21.88 deg, yaw -1.68 deg. Direction in detector frame.
DataChallenge.Source R2_DISTPAR0022_p1
R2_DISTPAR0022_p1.ParticleType 1
R2_DISTPAR0022_p1.Beam FarFieldGaussian 141.414 178.320 6.759
R2_DISTPAR0022_p1.Spectrum File R2_DISTPAR0022_p1_spectrum.dat
R2_DISTPAR0022_p1.Flux 0.141936
# Light-curve times are relative to t_ref = 1835709360.0 (unix s, first orientation row of this burst).
# Simulate with DC3_final_530km_3_month_with_slew_15sbins_GalacticEarth_cut_normed.ori and add t_ref to the simulated times afterwards.
# Original light curves (absolute unix times): R2_DISTPAR0022_p1_lightcurve.dat, R2_DISTPAR0022_p2_lightcurve.dat, R2_DISTPAR0022_p3_lightcurve.dat; see sim_time_reference.txt.
R2_DISTPAR0022_p1.Lightcurve File false R2_DISTPAR0022_p1_lightcurve_shifted.dat
R2_DISTPAR0022_p1.EarthOccultation false

# Piece 2 of 3: 98.511-197.662 s after the event start.
# Distant particle event: bremsstrahlung from electrons (exp(-E/500 keV)) precipitating
# over 90000 km2 at 10 deg Earth-central angle (1272 km away, zenith 119.5 deg,
# azimuth 180 deg from north). Peak precipitating flux 9.2e+03 e/cm2/s above 50 keV.
# Peak photon flux at COSI 0.255 ph/cm2/s; Flux below is the lightcurve-averaged value.
# Rocking +21.88 deg, yaw 5.14 deg. Direction in detector frame.
DataChallenge.Source R2_DISTPAR0022_p2
R2_DISTPAR0022_p2.ParticleType 1
R2_DISTPAR0022_p2.Beam FarFieldGaussian 141.414 185.140 6.759
R2_DISTPAR0022_p2.Spectrum File R2_DISTPAR0022_p2_spectrum.dat
R2_DISTPAR0022_p2.Flux 0.0566547
R2_DISTPAR0022_p2.Lightcurve File false R2_DISTPAR0022_p2_lightcurve_shifted.dat
R2_DISTPAR0022_p2.EarthOccultation false

# Piece 3 of 3: 197.662-300 s after the event start.
# Distant particle event: bremsstrahlung from electrons (exp(-E/500 keV)) precipitating
# over 90000 km2 at 10 deg Earth-central angle (1272 km away, zenith 119.5 deg,
# azimuth 180 deg from north). Peak precipitating flux 9.2e+03 e/cm2/s above 50 keV.
# Peak photon flux at COSI 0.255 ph/cm2/s; Flux below is the lightcurve-averaged value.
# Rocking +21.88 deg, yaw 11.96 deg. Direction in detector frame.
DataChallenge.Source R2_DISTPAR0022_p3
R2_DISTPAR0022_p3.ParticleType 1
R2_DISTPAR0022_p3.Beam FarFieldGaussian 141.414 191.960 6.759
R2_DISTPAR0022_p3.Spectrum File R2_DISTPAR0022_p3_spectrum.dat
R2_DISTPAR0022_p3.Flux 0.014855
R2_DISTPAR0022_p3.Lightcurve File false R2_DISTPAR0022_p3_lightcurve_shifted.dat
R2_DISTPAR0022_p3.EarthOccultation false
