# Define DC5 sim settings (optimizes sim time):
DefaultRangeCut 0.005
Region Spacecraft
Spacecraft.Volume SCbody
Spacecraft.RangeCut 1.

Region Pipebody
Pipebody.Volume PIPbody
Pipebody.RangeCut 1.

DataChallenge.Source               bn140329295
bn140329295.ParticleType    1
bn140329295.Beam            FarFieldPointSource 0.0 0.0

# Orientation: Latitude b [deg], Longitude l [deg]
bn140329295.Orientation     Galactic Fixed -28.2383 69.9894

# Spectrum 
bn140329295.Spectrum        Band 100 10000 -0.7746 -2.0816 141.47

# Average photon flux in photon/cm2/s
bn140329295.Flux            0.35643

# Polarization: fraction in [0,1], angle in [0,180]
bn140329295.Polarization       		galactic 0.00 73.3

# Lightcurve
# Light-curve times are relative to t_ref = 1835487300.0 (unix s, first time of the orientation file).
# Simulate with DC3_final_530km_3_month_with_slew_1sbins_GalacticEarth_cut_normed.ori and add t_ref to the simulated times afterwards.
# Original light curve (absolute unix times): bn140329295_lightcurve.dat; see sim_time_reference.txt.
bn140329295.Lightcurve      File false bn140329295_lightcurve_shifted.dat

# Earth occultation:
bn140329295.EarthOccultation false
