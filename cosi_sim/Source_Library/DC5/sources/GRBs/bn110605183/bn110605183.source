# Define DC5 sim settings (optimizes sim time):
DefaultRangeCut 0.005
Region Spacecraft
Spacecraft.Volume SCbody
Spacecraft.RangeCut 1.

Region Pipebody
Pipebody.Volume PIPbody
Pipebody.RangeCut 1.

DataChallenge.Source               bn110605183
bn110605183.ParticleType    1
bn110605183.Beam            FarFieldPointSource 0.0 0.0

# Orientation: Latitude b [deg], Longitude l [deg]
bn110605183.Orientation     Galactic Fixed 53.1256 240.6464

# Spectrum 
bn110605183.Spectrum        Band 100 10000 -0.3000 -2.3556 773.95

# Average photon flux in photon/cm2/s
bn110605183.Flux            2.28323

# Polarization: fraction in [0,1], angle in [0,180]
bn110605183.Polarization       		galactic 0.31 11.4

# Lightcurve
# Light-curve times are relative to t_ref = 1835487300.0 (unix s, first time of the orientation file).
# Simulate with DC3_final_530km_3_month_with_slew_1sbins_GalacticEarth_cut_normed.ori and add t_ref to the simulated times afterwards.
# Original light curve (absolute unix times): bn110605183_lightcurve.dat; see sim_time_reference.txt.
bn110605183.Lightcurve      File false bn110605183_lightcurve_shifted.dat

# Earth occultation:
bn110605183.EarthOccultation false
