# Define DC5 sim settings (optimizes sim time):
DefaultRangeCut 0.005
Region Spacecraft
Spacecraft.Volume SCbody
Spacecraft.RangeCut 1.

Region Pipebody
Pipebody.Volume PIPbody
Pipebody.RangeCut 1.

DataChallenge.Source               bn180504136
bn180504136.ParticleType    1
bn180504136.Beam            FarFieldPointSource 0.0 0.0

# Orientation: Latitude b [deg], Longitude l [deg]
bn180504136.Orientation     Galactic Fixed 26.8263 135.2441

# Spectrum 
bn180504136.Spectrum        Band 100 10000 -0.9029 -2.2656 235.98

# Average photon flux in photon/cm2/s
bn180504136.Flux            0.552749

# Polarization: fraction in [0,1], angle in [0,180]
bn180504136.Polarization       		galactic 0.09 150.3

# Lightcurve
# Light-curve times are relative to t_ref = 1835487300.0 (unix s, first time of the orientation file).
# Simulate with DC3_final_530km_3_month_with_slew_1sbins_GalacticEarth_cut_normed.ori and add t_ref to the simulated times afterwards.
# Original light curve (absolute unix times): bn180504136_lightcurve.dat; see sim_time_reference.txt.
bn180504136.Lightcurve      File false bn180504136_lightcurve_shifted.dat

# Earth occultation:
bn180504136.EarthOccultation false
