# Define DC3 sim settings (optimizes sim time):
DefaultRangeCut 0.005
Region Spacecraft
Spacecraft.Volume SCbody
Spacecraft.RangeCut 1.

Region Pipebody
Pipebody.Volume PIPbody
Pipebody.RangeCut 1.

DataChallenge.Source nova_co_511keV
nova_co_511keV.ParticleType			1
nova_co_511keV.Beam				FarFieldPointSource 0 0
nova_co_511keV.Orientation			Galactic Fixed 2.7256 310.9847
nova_co_511keV.Spectrum				Gaussian 511 1.27 3
nova_co_511keV.Lightcurve			File false nova_co_511keV_lc.dat
# Flux = time average over the light curve of the Hernanz (2014) CO nova model at 1 kpc (the correct model): DC3/DC4 peak flux 0.01537
nova_co_511keV.Flux				3e-06
nova_co_511keV.EarthOccultation false
