# Define DC3 sim settings (optimizes sim time):
DefaultRangeCut 0.005
Region Spacecraft
Spacecraft.Volume SCbody
Spacecraft.RangeCut 1.

Region Pipebody
Pipebody.Volume PIPbody
Pipebody.RangeCut 1.

DataChallenge.Source               bn161004964
bn161004964.ParticleType    1
bn161004964.Beam            FarFieldPointSource 0.0 0.0

# Orientation: Latitude b [deg], Longitude l [deg]
bn161004964.Orientation     Galactic Fixed -48.90083593193577 190.84721613954312

# Spectrum 
bn161004964.Spectrum        Band 100 10000 -0.8107229 -2.392184 114.00278370785078

# Average photon flux in photon/cm2/s
bn161004964.Flux            0.8569115647085793

# Polarization: fraction in [0,1], angle in [0,180]
bn161004964.Polarization       		galactic 0.6 10.00

# Lightcurve
# Light-curve times are relative to t_ref = 1835487300.0 (unix s, first time of the orientation file).
# Simulate with DC3_final_530km_3_month_with_slew_1sbins_GalacticEarth_cut_normed.ori and add t_ref to the simulated times afterwards.
# Original light curve (absolute unix times): bn161004964_lightcurve.dat; see sim_time_reference.txt.
bn161004964.Lightcurve      File false bn161004964_lightcurve_shifted.dat

# Earth occultation:
bn161004964.EarthOccultation false
